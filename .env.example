# Copy this file to .env for local testing.
# On Heroku, set these as Config Vars instead (Settings tab -> Reveal Config Vars),
# or via CLI: heroku config:set MONGODB_URI="..." ADMIN_KEY="..."

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/zetaboard?retryWrites=true&w=majority

# Secret key the app owner uses to push updates/messages. Pick your own long random string.
ADMIN_KEY=change-this-to-a-long-random-secret

# Heroku sets PORT itself - this is only used when running locally.
PORT=3000
